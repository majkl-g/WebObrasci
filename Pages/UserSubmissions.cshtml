@page
@using WebObrasci1.Services;
@model WebObrasci1.Pages.UserSubmissionsModel
@{
    ViewData["Title"] = "Predani obrasci";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model.SubmissionsPage.IsEmpty)
{
    <p>No submissions found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Obrazac</th>
                <th>Predan</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.SubmissionsPage.PageData)
            {
                var isApproved = s.Approvals.Any(a => a.ApprovalAsRole == Role.Profesor);
                var isDenied = s.Approvals.Any(a => a.Denied);
                var status = isApproved ? "Prihvaćeno" : (isDenied ? "Odbijeno" : "U obradi");

                <tr>
                    <td>@s.Form.Title</td>
                    <td>@s.SubmittedAt.ToLocalTime()</td>
                    <td>@status</td>
                    <td>
                        @* <a asp-page="/UserSubmissionDetails" asp-route-id="@s.Id">Pregled</a> *@
                        <a asp-page="/UserSubmissionDetails" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Pregled</a>
                        @if (!isApproved && !isDenied)
                        {
                            <form method="post" style="display:inline;">
                                <input type="hidden" name="submissionId" value="@s.Id" />
                                <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success">Prihvati</button>
                                <button type="submit" asp-page-handler="Deny" class="btn btn-sm btn-danger">Odbij</button>
                            </form>
                        }
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="paging">
        @if (Model.SubmissionsPage.PageNumber > 1)
        {
            <a asp-page="/UserSubmissions" asp-route-pageNumber="@(Model.SubmissionsPage.PageNumber - 1)" class="btn btn-sm btn-primary">Prethodna</a>
        }
        <p>@Model.SubmissionsPage.PageNumber</p>
        @if (Model.SubmissionsPage.PageNumber < Model.SubmissionsPage.TotalPages)
        {
            <a asp-page="/UserSubmissions" asp-route-pageNumber="@(Model.SubmissionsPage.PageNumber + 1)" class="btn btn-sm btn-primary">Sljedeca</a>
        }
    </div>
}