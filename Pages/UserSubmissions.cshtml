@page
@model WebObrasci1.Pages.UserSubmissionsModel
@{
    ViewData["Title"] = "My Submissions";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.Submissions.Any())
{
    <p>No submissions found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Form</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Submissions)
            {
                <tr>
                    <td>@s.Form.Title</td>
                    <td>@s.SubmittedAt.ToLocalTime()</td>
                    <td>
                        <a asp-page="/UserSubmissionDetails" asp-route-id="@s.Id">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}