@using WebObrasci1.Services;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebObrasci1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/cs

s/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebObrasci1.styles.css" asp-append-version="true" />
    <style>
        .header-banner {
            background-image: linear-gradient( rgba(255,255,255,0.85), rgba(255,255,255,0.85) ), url("/images/background.jpg");
            background-size: cover;
            background-position: center;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 200px;
            display: flex;
            align-items: center;
            padding: 40px 0;
            position: relative;
            margin-bottom: 0;
        }

        .banner-content {
            display: flex;
            align-items: center;
            gap: 40px;
            width: 100%;
            
        }

        
    </style>
</head>
<body>
    @{
        var showBanner = ViewData["ShowBanner"] as bool? ?? true;
    }

    @if (showBanner)
    {
        <div class="header-banner">
            <div class="container">
                <div class="banner-content">
                    <img src="~/images/riteh-znak-plavo.svg" alt="University Logo" class="logo-image" />
                </div>
            </div>
        </div>
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">WebObrasci</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">


                            <a class="nav-link text-dark" asp-area="" asp-page="/FormsList">Lista obrazaca</a>
                        </li>

                        @if (User.IsInRole(Role.Profesor) || User.IsInRole(Role.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/UserSubmissions">Ispunjeni Obrasci</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Forms/IndexForm">Promjena Obrasca</a>
                            </li>

                        }
                        @if (User.IsInRole(Role.Student))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/MySubmissions">Moji Obrasci</a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="navbar-nav ms-auto nav-item">
                                <a class="nav-link text-dark">@User.GetName()</a>
                                <a class="nav-link text-dark" href="/logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="navbar-nav ms-auto nav-item">
                                <a class="nav-link text-dark" href="/login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @*<footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WebObrasci1 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>*@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
