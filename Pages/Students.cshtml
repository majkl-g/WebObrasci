@page
@using WebObrasci1.Models
@model WebObrasci1.Pages.UsersModel
@{
	<h1>Students</h1>

	<form method = "post">
		
		<input type="number" name="id"/>
		<input type="text" name="name" />
		<input type="number" name="age" />
		

		<button type="submit">Add</button>
	</form>
	<table class="table">
	<thead>
	<tr>
		<th>Id</th>
		<th>Name</th>
		<th>Age</th>

	</tr>
	</thead>

	<tbody>
		@foreach(User User in Model.Users){
			<tr>
				<td>
					@User.Id
				</td>
				<td>
					@User.Name
				</td>
				<td>
					@User.Age
				</td>
			</tr>
		}
	</tbody>

	</table>
}
