@page
@using WebObrasci1.Models
@model WebObrasci1.Pages.StudentsModel
@{
	<h1>Students</h1>

	<form method = "post">
		
		<input type="number" name="id"/>
		<input type="text" name="name" />
		<input type="number" name="age" />
		

		<button type="submit">Add</button>
	</form>
	<table class="table">
	<thead>
	<tr>
		<th>Id</th>
		<th>Name</th>
		<th>Age</th>

	</tr>
	</thead>

	<tbody>
		@foreach(Student student in Model.Students){
			<tr>
				<td>
					@student.Id
				</td>
				<td>
					@student.Name
				</td>
				<td>
					@student.Age
				</td>
			</tr>
		}
	</tbody>

	</table>
}
