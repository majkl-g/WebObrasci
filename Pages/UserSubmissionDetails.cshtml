@page "{id:int}"
@model WebObrasci1.Pages.UserSubmissionDetailsModel
@using WebObrasci1.Services;
@{
    ViewData["Title"] = "Detalji predaje";
}

<h1>@ViewData["Title"]</h1>

@if (Model.Submission == null)
{
    <p>Obrazac nije nađen!</p>
}
else
{
    <p><strong>Obrazac:</strong> @Model.Submission.Form.Title</p>
    <p><strong>Predan:</strong> @Model.Submission.SubmittedAt.ToLocalTime()</p>

    if (!Model.Qa.Any())
    {
        <pre>@Model.Submission.DataJson</pre>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Pitanje</th>
                    <th>Odgovor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Qa)
                {
                    <tr>
                        <td>@item.Question</td>
                        <td>@item.Answer</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if(Model.Submission.Approvals.Any())
    {
        <div>
            <p><strong>Status:</strong></p>
            <ul>
                @foreach (var a in Model.Submission.Approvals)
                {
                    <li>
                        @if (a.Denied)
                        {
                            <span>@a.ApprovalUser?.UserName (@a.ApprovalAsRole) @a.ApprovedAt.ToLocalTime() (Odbijeno)</span>
                        }
                        else
                        {
                            <span>@a.ApprovalUser?.UserName (@a.ApprovalAsRole) @a.ApprovedAt.ToLocalTime() (Prihvaćeno)</span>
                        }

                        @if (@a.ApprovalUser?.ExternalId == Model.ExternalUserId)
                        {
                            <form method="post">
                                <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                                <input type="hidden" name="approvalId" value="@a.Id" />
                                <input type="hidden" name="action" value="delete" />
                                <button type="submit">Poništi</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <p><strong>Status:</strong> U obradi</p>

        @if (User.IsInRole(Role.Profesor) || User.IsInRole(Role.Admin))
        {
            <form method="post">
                <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                <input type="hidden" name="action" value="approve" />
                <button type="submit">Prihvati</button>
            </form>

            <form method="post">
                <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                <input type="hidden" name="action" value="deny" />
                <button type="submit">Odbij</button>
            </form>
        }
    }
}