@page "{id:int}"
@model WebObrasci1.Pages.FormFillModel

<h1>@Model.Form.Title</h1>

<form method="post">
    <validation-summary asp-validation-summary="All" class="text-danger"></validation-summary>

    @foreach (var field in Model.Form.Fields)
    {
        <div class="mb-3">
            <label>@field.Label</label>

            @if (field.Type == Models.FormFieldType.Text)
            {
                <input name="Answers[@field.Name]" class="form-control" />
            }
            else if (field.Type == Models.FormFieldType.Number)
            {
                <input type="number" name="Answers[@field.Name]" class="form-control" />
            }
            else if (field.Type == Models.FormFieldType.Date)
            {
                <input type="date" name="Answers[@field.Name]" class="form-control" />
            }
            else
            {
                <input name="Answers[@field.Name]" class="form-control" />
            }
        </div>
    }

    <button type="submit">Priloži</button>
</form>