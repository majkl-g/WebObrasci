@page
@using WebObrasci1.Services;
@model WebObrasci1.Pages.MySubmissionsModel
@{
    ViewData["Title"] = "Predani Obrasci";
}

<h1>@ViewData["Title"]</h1>

@if (Model.PageData.IsEmpty)
{
    <p>No submissions found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Obrazac</th>
                <th>Predan</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.PageData.PageData)
            {
                var isApproved = s.Approvals.Any(a => a.ApprovalAsRole == Role.Profesor && a.Denied == false);
                var isDenied = s.Approvals.Any(a => a.Denied);
                var status = isApproved ? "Prihvaćeno" : (isDenied ? "Odbijeno" : "U obradi");
                var statusClass = isApproved ? "badge bg-success" : (isDenied ? "badge bg-danger" : "badge bg-warning");

                <tr>
                    <td>@s.Form.Title</td>
                    <td>@s.SubmittedAt.ToLocalTime()</td>
                    <td><span class="@statusClass">@status</span></td>
                    <td>
                        <a asp-page="/UserSubmissionDetails" asp-route-id="@s.Id">Pregled</a>
                    </td>
                </tr>

            }
        </tbody>
    </table>

    @if (Model.PageData.TotalPages > 1)
    {
        <div class="paging">
            @if (Model.PageData.PageNumber > 1)
            {
                <a asp-page="/MySubmissions" asp-route-pageNumber="@(Model.PageData.PageNumber - 1)" class="btn btn-sm btn-primary">Prethodna</a>
            }
            <p>@Model.PageData.PageNumber</p>
            @if (Model.PageData.PageNumber < Model.PageData.TotalPages)
            {
                <a asp-page="/MySubmissions" asp-route-pageNumber="@(Model.PageData.PageNumber + 1)" class="btn btn-sm btn-primary">Sljedeca</a>
            }
        </div>
    }
}