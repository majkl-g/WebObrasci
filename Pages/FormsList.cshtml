@page
@model WebObrasci1.Pages.FormsListModel
@{
    ViewData["Title"] = "Dostupni obrasci";
}

<h1>@ViewData["Title"]</h1>

@if (Model.FormsPage.IsEmpty)
{
    <p>No forms available.</p>
}
else
{
    <ul>
        @foreach (var form in Model.FormsPage.PageData)
        {
            <li>
                <a asp-page="/FormFill" asp-route-id="@form.Id">
                    @form.Title
                </a>
            </li>
        }
    </ul>

    <div class="paging">
        @if (Model.FormsPage.PageNumber > 1)
        {
            <a asp-page="/FormsList" asp-route-pageNumber="@(Model.FormsPage.PageNumber - 1)" class="btn btn-sm btn-primary">Prethodna</a>
        }
        <p>@Model.FormsPage.PageNumber</p>
        @if (Model.FormsPage.PageNumber < Model.FormsPage.TotalPages)
        {
            <a asp-page="/FormsList" asp-route-pageNumber="@(Model.FormsPage.PageNumber + 1)" class="btn btn-sm btn-primary">Sljedeca</a>
        }
    </div>
}