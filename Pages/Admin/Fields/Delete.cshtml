@page
@model WebObrasci1.Pages.Admin.Fields.DeleteModel
@{
    <h1>Brisanje polja</h1>

    <p>Jeste li sigurni da želite izbrisati polje:  <strong>@Model.Field.Label</strong> ?</p>

    <form method="post">
        <input type="hidden" asp-for="Field.Id" />
        <button type="submit">Izbriši</button>
    </form>
}
