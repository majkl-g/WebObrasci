@model WebObrasci1.Pages.Admin.Fields.FieldModel
@using WebObrasci1.Models
@using System.Text.Json
@{
    <input type="hidden" asp-for="@Model.Field.Id" />
    <input type="hidden" asp-for="@Model.Field.FormId" />
    <input type="hidden" asp-for="@Model.Field.RowVersion" />

    <div>
        <label asp-for="@Model.Field.Label"></label>
        <input asp-for="@Model.Field.Label" class="form-control" />
    </div>

    <div>
        <label asp-for="@Model.Field.Name"></label>
        <input asp-for="@Model.Field.Name" class="form-control" />
    </div>

    <script type="text/javascript">
        function onFieldTypeChange(e) {
            let val = e.value;
            let minMaxDiv = document.getElementById("field-min-max");
            if (minMaxDiv){
                if (val == "@FormFieldType.Decimal" || val == "@FormFieldType.Integer"){
                    minMaxDiv.classList.remove("hidden");
                }
                else{
                    minMaxDiv.classList.add("hidden");
                }
            }

            let selectValsDiv = document.getElementById("field-select-vals");
            if(selectValsDiv){
                if (val == "@FormFieldType.Select"){
                    selectValsDiv.classList.remove("hidden");
                }
                else{
                    selectValsDiv.classList.add("hidden");
                }
            }
        }

        var selectVals = @Html.Raw(JsonSerializer.Serialize(Model.Field.SelectValues));

        function onFieldSelectValChange(e, i){
            let v = selectVals[i];
            if (v){
                v.Value = e.target.value;
            }
        }

        function getHtmlElementForSelectValInput(i){
            let newDiv = document.createElement('div');
            let newInput = document.createElement('input');
            newInput.type = "text";
            newInput.id = 'Field_SelectValues[' + i + ']_Value';
            newInput.name = 'Field.SelectValues[' + i + '].Value';
            newInput.classList.add("form-control");
            newInput.onchange = e => onFieldSelectValChange(e, i);
            newInput.value = selectVals[i]?.Value ?? "";
            newDiv.appendChild(newInput);
            let newButton = document.createElement('button');
            newButton.type="button";
            newButton.innerText="Ukloni";
            newButton.onclick = () => removeFieldSelectVal(i);
            newDiv.appendChild(newButton);
            return newDiv;
        }

        function addFieldSelectVal(){
            selectVals.push({ Value: ""});
            let selectValsDiv = document.getElementById("field-select-vals-inputs");
            if (selectValsDiv){
                let newInput = getHtmlElementForSelectValInput(selectVals.length - 1);
                selectValsDiv.appendChild(newInput);
            }
        }

        function refreshFieldSelectVal(){
            let selectValsDiv = document.getElementById("field-select-vals-inputs");
            if (selectValsDiv){
                for(let i = 0; i < selectVals.length; i++){
                    let newInput = getHtmlElementForSelectValInput(i);
                    selectValsDiv.appendChild(newInput);
                }
            }
        }

        function removeFieldSelectVal(i){
            selectVals.splice(i, 1);
            let selectValsDiv = document.getElementById("field-select-vals-inputs");
            if (selectValsDiv){
                selectValsDiv.innerHTML = "";
            }
            refreshFieldSelectVal();
        }
    </script>

    <div>
        <label asp-for="@Model.Field.Type"></label>
        <select asp-for="@Model.Field.Type" class="form-control" onchange="onFieldTypeChange(this)">
            <option value="@FormFieldType.Text">Text</option>
            <option value="@FormFieldType.Email">Email</option>
            <option value="@FormFieldType.Decimal">Decimal</option>
            <option value="@FormFieldType.Integer">Integer</option>
            <option value="@FormFieldType.Select">Select</option>
            <option value="@FormFieldType.Date">Date</option>
            <option value="@FormFieldType.CheckBox">CheckBox</option>
        </select>
    </div>

    <div id="field-min-max" class="hidden">
        <label asp-for="@Model.Field.MinValue"></label>
        <input asp-for="@Model.Field.MinValue" class="form-control" />

        <label asp-for="@Model.Field.MaxValue"></label>
        <input asp-for="@Model.Field.MaxValue" class="form-control" />
    </div>

    <div id="field-select-vals" class="hidden">
        <label>Vrijednosti:</label>
        <div id="field-select-vals-inputs">
        </div>
        <button type="button" onclick="addFieldSelectVal()">Dodaj</button>
    </div>

    <div>
        <label asp-for="@Model.Field.Required"></label>
        <input asp-for="@Model.Field.Required" type="checkbox" />
    </div>

    <div>
        <label asp-for="@Model.Field.FormAutofillMappingId">Mapiranje</label>
        <select asp-for="@Model.Field.FormAutofillMappingId" class="form-control">
            <option value="">Bez mapiranja</option>
            @foreach (var m in Model.AvailableMappings)
            {
                <option value="@m.Id">@m.Name</option>
            }
        </select>
    </div>

    <button type="submit">Spremi</button>
}