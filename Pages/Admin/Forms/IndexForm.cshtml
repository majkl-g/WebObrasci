@page
@model WebObrasci1.Pages.Admin.Forms.IndexFormModel
@{
    <h1>Forms</h1>
    <a asp-page="Create">Create New</a>

    <table class="table">
        <tr><th>Title</th><th>Actions</th></tr>
        @foreach (var f in Model.Forms)
        {
            <tr>
                <td>@f.Title</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@f.Id">Edit</a> |
                    <a asp-page="Delete" asp-route-id="@f.Id">Delete</a> |
                    <a asp-page="/Admin/Fields/IndexField" asp-route-formId="@f.Id">Fields</a>
                </td>
            </tr>
        }
    </table>
}
